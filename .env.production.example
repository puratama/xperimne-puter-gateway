# ========================================
# Docker Production (Traefik HTTP + Cloudflare Tunnel)
# Salin sebagai `.env.production` di server:  cp .env.production.example .env.production
# ========================================

# Hostname aplikasi (Traefik Host rule + origin Cloudflare Tunnel)
APP_DOMAIN="gateway.example.com"

# PostgreSQL (external host VPS) — wajib, compose gagal jika kosong
DB_HOST="host.docker.internal"       # host Postgres di VPS; default = host.docker.internal (sama VPS, via extra_hosts)
DB_USERNAME="rdai"
DB_PASSWORD="REPLACE_WITH_STRONG_DB_PASSWORD"
DB_DATABASE="rdai"

# DATABASE_URL di docker-compose.yml dibentuk otomatis dari DB_HOST/DB_*,
# tidak perlu di-set di sini.
# SHADOW_DATABASE_URL hanya untuk `prisma migrate dev` (opsional, tidak dipakai di prod).
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME_shadow?schema=public"

# ========================================
# Auth — JWT signing key & password salt
# Generate: openssl rand -base64 32
# ========================================
AUTH_SECRET="REPLACE_WITH_32_BYTE_RANDOM"            # JWT signing key
AUTH_SALT="REPLACE_WITH_RANDOM_STRING"                # Password hash salt

# Internal API keys — gates /api/v1/* routes (used by client to call its own backend)
# Generate each: openssl rand -base64 32
INTERNAL_API_KEY="REPLACE_WITH_RANDOM_STRING"
NEXT_PUBLIC_INTERNAL_KEY="REPLACE_WITH_SAME_AS_INTERNAL"   # dipakai sebagai build arg docker

# Public app URL — wajib https://${APP_DOMAIN} (dipakai sebagai build arg juga).
NEXT_PUBLIC_APP_URL="https://gateway.example.com"

# Cron secret — wajib di semua environment. Kalau kosong, /api/cron/* diblokir sepenuhnya.
CRON_SECRET="REPLACE_WITH_RANDOM_STRING"

# ========================================
# AI Provider (optional, mode env key)
# ========================================
# Token/API key dipakai bila provider di Admin Settings memakai mode "apiKeyEnv".
# Set yang relevan saja.

# OPENAI_API_KEY=""
# DEEPSEEK_API_KEY=""
# ANTHROPIC_API_KEY=""

# ========================================
# Google OAuth (Optional)
# ========================================
# For "Login with Google" feature. If unset, Google login button returns 503.
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://${APP_DOMAIN}/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ========================================
# Email Verification (SMTP)
# ========================================

# Pick any provider. For Gmail: App Password, NOT regular password.
SMTP_HOST="smtp.gmail.com"                            # smtp.gmail.com
SMTP_PORT="587"                                        # 587 (TLS) atau 465 (SSL)
SMTP_USER="youremail@gmail.com"
SMTP_PASS="REPLACE_WITH_APP_PASSWORD"
SMTP_FROM="noreply@yourdomain.com"

# ========================================
# Observability (Optional)
# ========================================

# Langfuse — LLM call tracing
LANGFUSE_HOST=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""

# ========================================
# Production Notes
# ========================================

# 1. Jalankan:  docker compose --env-file .env.production up -d --build
#    Migrate otomatis via service `migrate` (jalan sekali sebelum app up).
#    Jika ingin manual: docker compose run --rm migrate
# 2. Cloudflare Tunnel (cloudflared di host) → http://localhost:80,
#    Host header harus = ${APP_DOMAIN} agar Traefik Host rule cocok.
# 3. TLS/HTTPS ditangani Cloudflare; traefik hanya proxy HTTP internal.
# 4. Cron host (auth Bearer $CRON_SECRET), contoh:
#    0 * * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://$APP_DOMAIN/api/cron/expire-packages
#    0 0 1 * *  curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://$APP_DOMAIN/api/cron/monthly-reset
# 5. Payment gateway (Midtrans/Xendit) dikonfigurasi via UI Admin > Settings,
#    tidak ada env untuk ini.
# 6. Set permission file .env.production: chmod 600 .env.production
# 7. Backup PostgreSQL via cron di host atau gunakan service terpisah.