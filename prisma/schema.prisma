// This is your Prisma schema file,
// learn more about it in the docs: [REDACTED-URL]

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ====== Users & Auth ======

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?

  // OAuth / provider info
  provider   String  @default("email") // "email" | "google"
  providerId String? @unique            // Google sub (unique, nullable)
  avatar     String?

  // RBAC
  role String @default("user") // "user" | "superadmin"

  // Account status: active | suspended | banned
  status String @default("active")

  // Email verification
  emailVerified   DateTime?
  verifyToken     String?   @unique
  verifyExpiresAt DateTime?

  // Password reset
  resetToken     String?   @unique
  resetExpiresAt DateTime?

  // Relations
  apiKeys        ApiKey[]
  wallet         Wallet?
  packages       UserPackage[]
  usageRecords   UsageRecord[]
  billingRecords BillingRecord[]
  conversations  Conversation[]
  notifications  Notification[]
  supportTickets SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====== Conversations ======

model Conversation {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  model    String
  messages Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// ====== API Keys ======

model ApiKey {
  id     String  @id @default(cuid())
  key    String? @unique
  keyHash String? @unique
  name   String
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageRecords UsageRecord[]

  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  allModels    Boolean   @default(true)
  allowedModels String[] @default([])
  usageCount  Int       @default(0)
  totalTokens Int       @default(0)
  lastUsed    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isActive, expiresAt])
}

// ====== Wallet ======

model Wallet {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance   Decimal @default(0) @db.Decimal(18, 2) // IDR
  updatedAt DateTime @updatedAt
}

// ====== Plans ======

model Plan {
  id            String @id @default(cuid())
  name          String
  description   String?
  billingPeriod String // "daily" | "weekly" | "monthly" | "yearly"
  price         Decimal @db.Decimal(18, 2) // IDR

  // Quota limits
  maxTokensPerPeriod Int

  // Access control
  allowedModels    String[] // empty = none (used when allModels = false)
  allModels        Boolean  @default(true) // true = semua model diizinkan, false = wajib isi allowedModels
  allowedProviders String[] // empty = none (used when allProviders = false)
  allProviders     Boolean  @default(true) // true = semua provider diizinkan, false = wajib isi allowedProviders
  streaming        Boolean  @default(true)
  imageGeneration  Boolean  @default(false)

  // Free-text benefit list (e.g. "Full support", "Priority queue")
  highlights String[] @default([])

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  packages      UserPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====== User Packages ======

model UserPackage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status          String   @default("active") // active | expired | depleted
  tokensRemaining Int
  tokensTotal     Int
  expiresAt       DateTime

  billingId String?

  createdAt DateTime @default(now())
}

// ====== Usage Records ======

model UsageRecord {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  apiKeyId String?
  apiKey   ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  model    String
  provider String?
  source   String // "puter" | "aggregator"

  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  totalTokens      Int @default(0)

  cost     Decimal? @db.Decimal(18, 6)
  endpoint String

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
}

// ====== Billing Records ======

model BillingRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   String // "topup" | "package_purchase" | "subscription"
  amount Decimal @db.Decimal(18, 2) // IDR
  status String  @default("pending") // pending | pending_confirmation | paid | failed | expired

  provider String? // "midtrans" | "xendit" | "qris" — payment channel used

  midtransOrderId String? @unique
  midtransToken   String?
  midtransUrl     String?

  planId      String?
  description String?

  // Manual verification (QRIS merchant): user proof + admin decision
  proofNote  String?
  proofImage String?
  verifiedAt DateTime?

  // Telegram bot notification (editable message for approve/reject)
  telegramChatId   String?
  telegramMessageId Int?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
}

// ====== Announcements ======

model Announcement {
  id          String   @id @default(cuid())
  title       String
  description String
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, createdAt])
}

// ====== Support ======

model SupportTicket {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject  String
  category String
  priority String @default("normal") // "low" | "normal" | "high"
  status   String @default("open")  // "open" | "in_progress" | "resolved" | "closed"
  messages Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// ====== Notifications ======

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String // "usage_alert" | "low_balance" | "system"
  title   String
  message String
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

// ====== App Models (sold in app) ======

model AppModel {
  id        String @id @default(cuid())
  modelId   String @unique
  name      String
  provider  String
  providerModelId String?
  maxOutputTokens Int?

  // Pricing — cost to us
  costPer1kPrompt              Decimal? @db.Decimal(18, 6)
  costPer1kCompletion           Decimal? @db.Decimal(18, 6)
  markupPercent                 Decimal  @default(0) @db.Decimal(8, 2)

  // PAYG price (default, higher)
  sellPricePer1kPrompt          Decimal? @db.Decimal(18, 6)
  sellPricePer1kCompletion       Decimal? @db.Decimal(18, 6)

  // Token Plan price (discounted, used when client has active UserPackage)
  tokenPlanPricePer1kPrompt     Decimal? @db.Decimal(18, 6)
  tokenPlanPricePer1kCompletion  Decimal? @db.Decimal(18, 6)

  isActive Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====== Aggregator Config ======

model AggregatorConfig {
  id        String  @id @default(cuid())
  name      String
  baseUrl   String
  apiKeyEnc String // encrypted
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====== Site Settings (key-value) ======

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ====== Payment Gateway Config ======

model PaymentGatewayConfig {
  id           String   @id @default(cuid())
  provider     String   @default("midtrans") // "midtrans" | "xendit" | "qris"
  name         String
  serverKeyEnc String
  clientKeyEnc String
  environment  String   @default("sandbox") // sandbox | production
  isActive     Boolean  @default(true)
  qrisPayload  String? // static QRIS EMV string, only used when provider == "qris"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====== Telegram Bot (manual payment verification channel) ======

model TelegramConfig {
  id           String   @id @default("telegram") // singleton row
  botTokenEnc  String? // bot token from @BotFather (plaintext, follows *Enc codebase convention)
  adminChatIds String[] @default([]) // Telegram chat IDs that receive payment notifications
  isEnabled    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
