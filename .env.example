# ========================================
# Required Configuration (Local Dev)
# ========================================

# Database — PostgreSQL connection string (local dev).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public"

# Shadow DB — dipakai `prisma migrate dev` (optional, jika pakai db push tidak perlu)
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME_shadow?schema=public"

# ========================================
# Auth — JWT signing key & password salt
# Generate: openssl rand -base64 32
# ========================================
AUTH_SECRET="REPLACE_WITH_32_BYTE_RANDOM"            # JWT signing key
AUTH_SALT="REPLACE_WITH_RANDOM_STRING"                # Password hash salt

# Internal API keys — gates /api/v1/* routes (used by client to call its own backend)
# Generate each: openssl rand -base64 32
INTERNAL_API_KEY="REPLACE_WITH_RANDOM_STRING"
NEXT_PUBLIC_INTERNAL_KEY="REPLACE_WITH_SAME_AS_INTERNAL"

# Public app URL — Sesuaikan dengan port dev project (3035).
NEXT_PUBLIC_APP_URL="http://localhost:3035"

# Cron secret — wajib di semua environment. Kalau kosong, /api/cron/* diblokir sepenuhnya.
CRON_SECRET="REPLACE_WITH_RANDOM_STRING"

# ========================================
# AI Provider
# ========================================
# Token/API key dipakai bila provider di Admin Settings memakai mode "apiKeyEnv".
# Set yang relevan saja.

# Optional — provider langsung (dipakai via Admin Settings > Providers, mode env key)
# OPENAI_API_KEY=""
# DEEPSEEK_API_KEY=""
# ANTHROPIC_API_KEY=""

# ========================================
# Google OAuth (Optional)
# ========================================
# For "Login with Google" feature. If unset, Google login button shows 503.
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ========================================
# Email Verification (SMTP)
# ========================================

# Pick any provider. For Gmail: App Password, NOT regular password.
SMTP_HOST="smtp.gmail.com"                            # smtp.gmail.com
SMTP_PORT="587"                                        # 587 (TLS) or 465 (SSL)
SMTP_USER="youremail@gmail.com"
SMTP_PASS="REPLACE_WITH_APP_PASSWORD"
SMTP_FROM="noreply@yourdomain.com"

# Dev fallback: jika SMTP_HOST dsb. kosong, email di-console.log

# ========================================
# Payment Gateway (Optional - Configured via Admin Settings)
# ========================================
# Semua konfigurasi payment (Midtrans/Xendit) disimpan di database.
# Atur lewat UI: Admin > Settings > Payment Gateway. Tidak ada env untuk ini.

# ========================================
# Observability (Optional)
# ========================================

# Langfuse — LLM call tracing
LANGFUSE_HOST=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""

# ========================================
# Notes
# ========================================

# 1. Salin file ini menjadi `.env` (bukan .env.local):  cp .env.example .env
# 2. Replace SEMUA "REPLACE_WITH_*" dengan nilai beneran.
# 3. `.env` TIDAK di-commit ke git (lihat .gitignore). `.env.example` di-commit sebagai panduan.
# 4. Deploy Docker: pakai `.env.production.example` sebagai acuan.
# 5. Prioritas env Next.js: .env.local > .env.development > .env. Pakai SATU file `.env` saja di local
#    dan pastikan tidak ada `.env.local` agar tidak menimpa nilai yang sama.
# 6. OPENAI_API_KEY, DEEPSEEK_API_KEY, ANTHROPIC_API_KEY, MIDTRANS_CLIENT_KEY,
#    XENDIT_SECRET_KEY, XENDIT_PUBLIC_KEY, MIDTRANS_SERVER_KEY, MIDTRANS_IS_PRODUCTION,
#    XENDIT_CALLBACK_TOKEN sudah dipindah ke Admin Settings (Payment Gateway, Providers)
#    dan disimpan di database. Provider key di atas hanya opsional bila provider di DB
#    memakai mode "apiKeyEnv".
